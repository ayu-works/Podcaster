# Copy to .env and fill in. Never commit .env.
# The block that first needs each key is noted, so you can fill them in as you go.

# --- Block 2: catalogue -------------------------------------------------------
# podcastindex.org/api/docs — instant signup, emails you BOTH values.
# Auth is sha1(key + secret + unix_timestamp), so the secret is not optional.
PODCASTINDEX_KEY=your_key_here
PODCASTINDEX_SECRET=your_secret_here

# --- Block 5: shared episode tagger ------------------------------------------
# console.groq.com — free, instant, no card.
GROQ_API_KEY=your_key_here

# Groq rotates and retires model IDs, and a stale one fails at request time
# (inside the 7am job), not at import. Check console.groq.com/docs/models.
# Preference order for this tagger, best first:
#   openai/gpt-oss-120b    strongest instruction-following, JSON mode
#   qwen/qwen3.6-27b       solid step down
#   openai/gpt-oss-20b     smaller; expect weaker "why this" lines
#   llama-3.1-8b-instant   last resort; too small to honour rule 3 well
GROQ_MODEL=openai/gpt-oss-120b

# --- Block 6: email -----------------------------------------------------------
RESEND_API_KEY=your_key_here

# Sandbox sender only delivers to the Resend account owner. For production,
# verify a sending subdomain and use an address at that subdomain.
FROM_EMAIL="Podcaster <digest@updates.yourdomain.com>"

# Public Vercel/onboarding URL. Used in confirmation and unsubscribe links.
PUBLIC_BASE_URL=http://127.0.0.1:5001

# --- Shared hosted database --------------------------------------------------
# Required in GitHub Actions and Vercel. Leave empty for local SQLite only.
# In Turso, create a standard libSQL database (not the TursoDB/Rust driver),
# then copy both values from the database's Connect page. The URL must begin
# with libsql:// and the token must have full read/write access.
DATABASE_URL=libsql://your_database_name-your_org.turso.io
DATABASE_TOKEN=your_full_access_database_token_here
